// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Queimadas {
  id          String   @id @default(uuid())
  bdq_id     String
  foco_id     String
  lat         String
  lon         String
  data        DateTime @db.Timestamp
  country     String
  state       String
  city        String
  biome       String
  source_file String
  csv_file    String
}

model Municipios {
  Cod_UF                    String?
  UF                        String?
  Cod_Regiao_Intermediaria String?
  Regiao_Intermediaria     String?
  Cod_Regiao_Imediata      String?
  Regiao_Imediata          String?
  Cod_Mesorregiao          String?
  Mesorregiao              String?
  Cod_Microrregiao         String?
  Microrregiao             String?
  Cod_Munic_Comp           String @id
  Municipio                String?
  Regiao_Planejamento      String?
  latitude                 String?
  longitude                String?
  COD_MUNIC_6              String?
  AREA                     String?
  COD_MUNIC_4              String?
  RIDE                     String?
  REGIONAL_IEL             String?
  Capital                  String?
  MACROREGIAO              String?
}
