// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Queimadas {
  id          String   @id @default(uuid())
  bdq_id     String
  foco_id     String
  lat         String
  lon         String
  data        DateTime @db.Timestamp
  country     String
  state       String
  city        String
  biome       String
  source_file String
  csv_file    String
}
